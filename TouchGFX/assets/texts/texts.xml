    <TextGroup Id="script">
      <Text Id="script15" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：与你遇到的第7个人进行一场目标为10区的赛跑。</Translation>
      </Text>
      <Text Id="script14" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：在3时24分面带微笑地照镜子，然后击碎镜中的物品。</Translation>
      </Text>
      <Text Id="script13" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：在L区行走三十七步后于面前的便利店购买一把水果刀。</Translation>
      </Text>
      <Text Id="script12" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：切割一缕月光，时限为30天。</Translation>
      </Text>
      <Text Id="script11" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：在时针位于7与8之间时制作蛋白酥皮奶油卷并一边看电影一边享用它。</Translation>
      </Text>
      <Text Id="script10" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：身着淡绿色衣物并在三角形的街道上走十步。</Translation>
      </Text>
      <Text Id="script9" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：立刻回家，有狗在家门口叫过一声后才可开门。</Translation>
      </Text>
      <Text Id="script8" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：于接受指令后的第二天早上睁开眼睛时便立刻喝下三杯水。</Translation>
      </Text>
      <Text Id="script7" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：将餐后余下的碗全部丢弃。</Translation>
      </Text>
      <Text Id="script6" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：抚摸5次用四足行走的动物。</Translation>
      </Text>
      <Text Id="script5" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：将你所遇到的第23个人的指甲修剪整齐。</Translation>
      </Text>
      <Text Id="script4" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：吃下五根红色的香蕉后跳入洗碗槽中。</Translation>
      </Text>
      <Text Id="script3" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：用盐水温煮自己的声带，并食用。</Translation>
      </Text>
      <Text Id="script2" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：在本月的第二个阴天为一盆植物浇水。</Translation>
      </Text>
      <Text Id="script1" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">致：在亲吻第62朵向日葵时仰望蓝天，并向你在此之后遇到的第四个年轻女孩表白，直至对方同意。</Translation>
      </Text>
      <Text Id="samples" Alignment="Left" TypographyId="scriptext">
        <Translation Language="GB">＠＃＄％＆＊＋＝？～！知道了=（</Translation>
